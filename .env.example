# Copy to .env (git-ignored) and fill in. Load before running:  set -a; source .env; set +a
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=
# Option A: a named profile from ~/.aws (preferred)
AWS_PROFILE=incident-assistant
# Option B: a Bedrock API key
# AWS_BEARER_TOKEN_BEDROCK=
# Option C: IAM access keys
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional LangSmith tracing (Python)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=incident-investigator
